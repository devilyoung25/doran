# Proyecto → Project Settings → General → Reference ID
SUPABASE_PROJECT_REF=

# Project Settings → Database → contraseña definida al crear el proyecto.
# Usa la conexión directa (puerto 5432) para migraciones, no el pooler de 6543.
# Si la contraseña contiene @, escríbela como %40 dentro de esta URL.
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Project Settings → API. La clave anon es pública; la service role no va aquí.
VITE_SUPABASE_URL=https://[PROJECT_REF].supabase.co
VITE_SUPABASE_ANON_KEY=
